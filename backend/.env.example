# Server Port (Default: 6000 per BACKEND_OVERVIEW.md)
PORT=6000

# Allowed Frontend Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,https://ui-revive.vercel.app

# Neon.tech Serverless PostgreSQL Connection String
# Get a free PostgreSQL database at: https://neon.tech
# Format: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# AI Provider Keys (Configure at least one; Groq is recommended for instant free responses)
# 1. Groq (Free: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini (Free: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 3. Ollama (Local or Cloud)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional custom path to Chrome/Edge executable for Headless Scraping
CHROME_EXECUTABLE_PATH=

